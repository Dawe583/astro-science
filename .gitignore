# =============================================================================
# astro-science — root repository
# Tracks: workspace config, research workspace, wiki, skills, graphs, docs.
# Excludes: virtualenvs, caches, foreign cloned repos, large binaries.
# =============================================================================

# --- Python environment & caches --------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
catboost_info/
.ipynb_checkpoints

# --- Foreign cloned tutorial repositories (separate upstream repos) ----------
# These are cloned reference material with their own git history. They are
# analyzed by Understand-Anything via .understandignore, but not versioned here.
notebooks/
mast_notebooks/
gaia-jupyter-notebooks/
AstroInteractives/

# --- Nested standalone research repository -----------------------------------
# exotic-compact-objects has its own git remote and history.
# It IS analyzed by Understand-Anything, but is versioned independently.
research/projects/exotic-compact-objects/

# --- Large binaries / data ---------------------------------------------------
*.zip
*.npz
*.npy
*.h5
*.hdf5
*.zarr
*.tar
*.tar.gz
*.tgz

# --- Understand-Anything scratch (keep committed artifacts) ------------------
.ua/intermediate/
.ua/tmp/
.ua/.trash-*/
.ua/diff-overlay.json
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/.trash-*/
.understand-anything/diff-overlay.json

# --- Logs --------------------------------------------------------------------
logs/
*.log

# --- OS / editors ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
